{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CACHE",
  "version": "0.1.0",
  "identifier": "org.cache.survival",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @cache/web",
    "beforeBuildCommand": "npm run build -w @cache/web"
  },
  "app": {
    "windows": [
      {
        "title": "CACHE — Offline Survival AI",
        "width": 1280,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
